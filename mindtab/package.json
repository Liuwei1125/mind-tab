{
  "name": "mindtab",
  "version": "0.1.0",
  "private": true,
  "description": "AI Native Browser New Tab Workspace",
  "scripts": {
    "dev": "turbo run dev",
    "dev:extension": "pnpm --filter @mindtab/extension dev",
    "dev:dashboard": "pnpm --filter @mindtab/dashboard dev",
    "build": "turbo run build",
    "build:extension": "pnpm --filter @mindtab/extension build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.14.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
